pipeline {
    agent any

    triggers {
        // Automatically triggers build on GitHub webhook push event
        githubPush()
    }

    options {
        timestamps() // Adds timestamps to every console log line
        timeout(time: 30, unit: 'MINUTES')
    }

    tools {
        maven "MAVEN3"
        jdk "JDK17"
    }

    environment {
        AWS_REGION        = "us-east-1"
        AWS_ACCOUNT_ID    = "851706351853"
        AWS_REGISTRY      = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        ECR_REPOSITORY    = "vprofile-app"
        ECR_IMAGE         = "${AWS_REGISTRY}/${ECR_REPOSITORY}"
        ECS_CLUSTER       = "vprofile-cluster"
        ECS_SERVICE       = "vprofile-service"
        MAVEN_OPTS        = "-Xms256m -Xmx1024m"
        SLACK_WEBHOOK_URL = credentials('slack-webhook-url')
    }

    stages {
        stage('FETCH CODE') {
            steps {
                script {
                    echo "=================================================================="
                    echo "🚀 Fetching code on branch: ${env.GIT_BRANCH ?: 'Docker_ECSR'}"
                    echo "Author: Ankit Gawade | Target: Docker -> Amazon ECR -> Amazon ECS"
                    echo "=================================================================="
                }

                // Send Slack notification: Pipeline Started
                sh """
                    curl -s -X POST -H 'Content-type: application/json' \
                    --data '{"attachments": [{"color": "#3AA3E3", "title": "🚀 Container CI/CD Started: ${env.JOB_NAME} #${env.BUILD_NUMBER}", "title_link": "${env.BUILD_URL}", "fields": [{"title": "Project", "value": "VProfile Modern Cloud Native", "short": true}, {"title": "Branch", "value": "${env.GIT_BRANCH ?: 'Docker_ECSR'}", "short": true}, {"title": "Author", "value": "Ankit Gawade", "short": true}, {"title": "Target Architecture", "value": "Docker -> ECR -> ECS Fargate", "short": true}], "footer": "Ankit Infotech Cloud Automation"}]}' \
                    ${SLACK_WEBHOOK_URL} || true
                """
            }
        }

        stage('UNIT TEST') {
            steps {
                dir('v_project') {
                    echo "Running Maven Unit Tests..."
                    sh 'mvn test'
                }
            }
        }

        stage('CHECKSTYLE') {
            steps {
                dir('v_project') {
                    echo "Running Maven Checkstyle Code Quality Audit..."
                    sh 'mvn checkstyle:checkstyle'
                }
            }
            post {
                success {
                    echo 'Generated Checkstyle Analysis Result'
                }
            }
        }

        stage('CODE ANALYSIS (SONARQUBE)') {
            environment {
                scannerHome = tool 'sonarscanner4'
            }
            steps {
                dir('v_project') {
                    withSonarQubeEnv('sonar-pro') {
                        sh '''${scannerHome}/bin/sonar-scanner -Dsonar.projectKey=vprofile \
                            -Dsonar.projectName=vprofile-repo \
                            -Dsonar.projectVersion=2.0-docker \
                            -Dsonar.sources=src/ \
                            -Dsonar.java.binaries=target/test-classes/com/vprofile/account/controllerTest/ \
                            -Dsonar.junit.reportsPath=target/surefire-reports/ \
                            -Dsonar.jacoco.reportsPath=target/jacoco.exec \
                            -Dsonar.java.checkstyle.reportPaths=target/checkstyle-result.xml'''
                    }

                    timeout(time: 10, unit: 'MINUTES') {
                        waitForQualityGate abortPipeline: true
                    }
                }
            }
        }

        stage('DOCKER BUILD') {
            steps {
                dir('v_project') {
                    script {
                        echo "Compiling and packaging WAR artifact..."
                        sh 'mvn clean package -DskipTests'

                        echo "Building Docker Image: ${ECR_IMAGE}:${env.BUILD_NUMBER} and ${ECR_IMAGE}:latest..."
                        sh "docker build -t ${ECR_IMAGE}:${env.BUILD_NUMBER} -t ${ECR_IMAGE}:latest ."
                    }
                }
            }
        }

        stage('PUSH TO AMAZON ECR') {
            steps {
                script {
                    echo "Authenticating Docker with Amazon ECR (${AWS_REGION})..."
                    sh "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${AWS_REGISTRY}"

                    echo "Pushing image tag #${env.BUILD_NUMBER} to ECR..."
                    sh "docker push ${ECR_IMAGE}:${env.BUILD_NUMBER}"

                    echo "Pushing latest image tag to ECR..."
                    sh "docker push ${ECR_IMAGE}:latest"
                }
            }
        }

        stage('ECS DEPLOY') {
            steps {
                script {
                    echo "Triggering zero-downtime rolling deployment on Amazon ECS Service: ${ECS_SERVICE}..."
                    sh """
                        aws ecs update-service \
                            --cluster ${ECS_CLUSTER} \
                            --service ${ECS_SERVICE} \
                            --force-new-deployment \
                            --region ${AWS_REGION}
                    """

                    echo "Waiting for ECS service stability (new task spinning up)..."
                    sh """
                        aws ecs wait services-stable \
                            --cluster ${ECS_CLUSTER} \
                            --services ${ECS_SERVICE} \
                            --region ${AWS_REGION} || true
                    """
                    echo "✅ Amazon ECS deployment command completed successfully!"
                }
            }
        }
    }

    post {
        success {
            sh """
                curl -s -X POST -H 'Content-type: application/json' \
                --data '{"attachments": [{"color": "#2EB886", "title": "✅ Container Pipeline Succeeded: ${env.JOB_NAME} #${env.BUILD_NUMBER}", "title_link": "${env.BUILD_URL}", "fields": [{"title": "Project", "value": "VProfile Modern Cloud Native", "short": true}, {"title": "Branch", "value": "${env.GIT_BRANCH ?: 'Docker_ECSR'}", "short": true}, {"title": "Author", "value": "Ankit Gawade", "short": true}, {"title": "Quality Gate", "value": "PASSED (SonarQube)", "short": true}, {"title": "Amazon ECR Image", "value": "${ECR_REPOSITORY}:${env.BUILD_NUMBER}", "short": true}, {"title": "Amazon ECS", "value": "Deployed to Fargate", "short": true}], "footer": "Ankit Infotech Cloud Automation"}]}' \
                ${SLACK_WEBHOOK_URL} || true
            """
        }
        failure {
            sh """
                curl -s -X POST -H 'Content-type: application/json' \
                --data '{"attachments": [{"color": "#E01E5A", "title": "❌ Container Pipeline Failed: ${env.JOB_NAME} #${env.BUILD_NUMBER}", "title_link": "${env.BUILD_URL}", "fields": [{"title": "Project", "value": "VProfile Modern Cloud Native", "short": true}, {"title": "Branch", "value": "${env.GIT_BRANCH ?: 'Docker_ECSR'}", "short": true}, {"title": "Author", "value": "Ankit Gawade", "short": true}, {"title": "Status", "value": "Pipeline halted. Check Jenkins logs.", "short": false}], "footer": "Ankit Infotech Cloud Automation"}]}' \
                ${SLACK_WEBHOOK_URL} || true
            """
        }
        cleanup {
            cleanWs deleteDirs: true, notFailBuild: true
        }
    }
}
